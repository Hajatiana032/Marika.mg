{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Connexion{% endblock %}

{% block body %}
<div class="container">
    <form method="post">
        <h1 class="h3 mb-3 font-weight-normal text-center">Connexion</h1>
        {% if app.user %}
        <div class="mb-3 text-center">
            Vous êtes connecté(e)s en tant que {{ app.user.username }}, <a href="{{ path('app_logout') }}"
                class="link-blue-600">Se
                déconnecter</a>
        </div>
        {% endif %}
        {% if error %}
        <div class="alert bg-danger text-white text-center">{{ error.messageKey|trans(error.messageData, 'security')|raw
            }}
        </div>
        {% endif %}
        {{ include('partials/_flash_messages.html.twig') }}
        <label for="username">Adresse email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
            autocomplete="email" required autofocus>
        <label for="password" class="mt-3">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password"
            required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
            value="{{ csrf_token('authenticate') }}">

        {#
        Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
        See https://symfony.com/doc/current/security/remember_me.html

        <div class="checkbox mb-3">
            <input type="checkbox" name="_remember_me" id="_remember_me">
            <label for="_remember_me">Remember me</label>
        </div>
        #}

        <button class="btn btn-lg btn-blue-600 mt-3" type="submit">
            Connexion
        </button>
    </form>
</div>
{% endblock %}