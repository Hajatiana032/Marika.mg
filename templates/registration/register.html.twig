{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Inscription{% endblock %}

{% block body %}
<div class="container">{% for flash_error in app.flashes('verify_email_error') %}
    <div class="alert bg-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1 class="text-center">Inscription</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
    <div class="row">
        <div class="mb-3 form-group col-xl-6">
            {{ form_label(registrationForm.lastName) }}
            {{ form_widget(registrationForm.lastName) }}
            {{ form_errors(registrationForm.lastName) }}
        </div>
        <div class="mb-3 form-group col-xl-6">
            {{ form_label(registrationForm.firstName) }}
            {{ form_widget(registrationForm.firstName) }}
            {{ form_errors(registrationForm.firstName) }}
        </div>
        <div class="mb-3 form-group col-xl-3">
            {{ form_label(registrationForm.phone) }}
            <div class="input-group">
                {{ form_widget(registrationForm.phone) }}
                <span class="input-group-text border-blue-600 border-2 border-start-0 text-body">+261</span>
            </div>
            {{ form_errors(registrationForm.phone) }}
        </div>
        <div class="mb-3 form-group col-xl-3">
            {{ form_label(registrationForm.address) }}
            {{ form_widget(registrationForm.address) }}
            {{ form_errors(registrationForm.address) }}
        </div>
        <div class="mb-3 form-group col-xl-3">
            {{ form_label(registrationForm.city) }}
            {{ form_widget(registrationForm.city) }}
            {{ form_errors(registrationForm.city) }}
        </div>
        <div class="mb-3 form-group col-xl-3">
            {{ form_label(registrationForm.zipCode) }}
            {{ form_widget(registrationForm.zipCode) }}
            {{ form_errors(registrationForm.zipCode) }}
        </div>
        <div class="mb-3 form-group">
            {{ form_label(registrationForm.username) }}
            {{ form_widget(registrationForm.username) }}
            {{ form_errors(registrationForm.username) }}
        </div>
        <div class="mb-3 form-group">
            {{ form_label(registrationForm.email) }}
            {{ form_widget(registrationForm.email) }}
            {{ form_errors(registrationForm.email) }}
        </div>
        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword) }}
            {{ form_widget(registrationForm.plainPassword) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>
        <div class="mb-3">
            {{ form_label(registrationForm.avatarFile) }}
            {{ form_widget(registrationForm.avatarFile) }}
            {{ form_errors(registrationForm.avatarFile) }}
        </div>
        {{ form_row(registrationForm.agreeTerms) }}

    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-outline-blue-600 text-end">Terminer</button>
    </div>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}