<div{{ attributes }}>
    <!-- component HTML -->
    {{ form_start(form) }}
    <div class="row">
        <div class="col-xl-6">
            {{ form_row(form.lastName) }}
        </div>
        <div class="col-xl-6">
            {{ form_row(form.firstName) }}
        </div>
        <div class="col-xl-6">
            {{ form_row(form.phone) }}
        </div>
        <div class="col-xl-6">
            {{ form_row(form.address) }}
        </div>
        <div class="col-xl-6">
            {{ form_row(form.zipCode) }}
        </div>
        <div class="col-xl-6">
            {{ form_row(form.city, {attr:{'data-action': 'live#action','data-live-action-param':'shippingCost',
                'data-model': 'cityId'}}) }}
        </div>
        <div class="col-xl-6">
            {{ form_label(form.paymentMethod) }}
            <i class="fa fa-hand-holding-dollar"></i>&nbsp;
            <i class="fab fa-stripe"></i>
            {{ form_widget(form.paymentMethod) }}
            {{ form_errors(form.paymentMethod) }}
        </div>
        <div class="text-end">
            <button type="submit" class="btn btn-lg btn-outline-blue-600" data-turbo="false">
                Continuer
                <i class="fa fa-arrow-right-long"></i>
            </button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
