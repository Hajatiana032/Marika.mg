{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Réinitialiser votre mot de passe{% endblock %}

{% block body %}
<div class="container">
    <h1>Réinitialiser votre mot de passe</h1>
    {{ form_start(resetForm) }}
    {{ form_row(resetForm.plainPassword) }}
    <button class="btn btn-blue-600">Réinitialiser</button>
    {{ form_end(resetForm) }}
</div>
{% endblock %}