{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Checkout{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="display-5">Checkout</h1>
        <div class="row">
            <div class="col-xl-6">
                <twig:CheckoutForm/>
            </div>
            <div class="col-xl-6">
                <div class="card shadow border-emerald-500 border-2 h-100">
                    <div class="card-body">
                        <h4>Montant à payer :</h4>
                        <h5 class="mb-3">{{ total|format_currency('MGA',{},'fr_MG') }}</h5>
                        <h4>Frais de livraison :</h4>
                        <h5 class="mb-3">
                            <twig:ShippingCost/>
                        </h5>
                        <h4>Total à payer:</h4>
                        <h5>
                            <twig:TotalPrice/>
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
