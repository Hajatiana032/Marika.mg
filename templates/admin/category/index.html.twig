{% extends 'admin/admin.html.twig' %}

{% block admin_title %}Catégories{% endblock %}

{% block main %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <h1>Liste des catégories</h1>
            </div>
            <div class="col-xl-6 text-end">
                <a href="{{ path('app_admin_category_new') }}" class="btn btn-emerald-500 ms-xl-auto"><i class="fa
                fa-plus"></i>&nbsp;Nouvelle
                    catégorie</a>
            </div>
            {% include 'partials/_flash_messages.html.twig' %}
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Slug</th>
                    <th>Total de produits associés</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.name }}</td>
                        <td>{{ category.slug }}</td>
                        <td class="d-flex">
                            <div>
                                {{ category.products|length }}
                            </div>
                            <div class="ms-auto">
                                <button class="btn btn-emerald-500" data-bs-toggle="modal"
                                        data-bs-target="#productList-{{ category.id }}"
                                        {% if category.products is empty %}disabled{% endif %}>
                                    Voir la liste
                                </button>
                            </div>
                        </td>
                        <td>
                            <a href="{{ path('app_admin_category_update', {slug: category.slug}) }}" class="btn
                            btn-warning"><i
                                    class="far
                            fa-edit"></i>&nbsp;
                                Modifier</a>
                            <a href="{{ path('app_admin_category_delete', {slug: category.slug}) }}" class="btn
                            btn-danger">
                                <i class="fa fa-trash"></i>&nbsp;Supprimer</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-danger">Aucun résultat</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% for category in categories %}
        {% include 'admin/partials/_product_list_modal.html.twig' with {'title': 'Catégorie','item': category} %}
    {% endfor %}
{% endblock %}
