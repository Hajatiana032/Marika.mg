<style>
    table {
        border-collapse: collapse;
    }

    body {
        color: rgba(0, 0, 0, 0.76);
    }

    table, th, td {
        border: 0.5px solid #c9c5c5;
        width: 100%;
    }

    th, td {
        padding: 8px;
    }

    th {
        text-align: left;

    }

    caption {
        text-align: left;
        margin-top: 25px;
        font-size: 20px;
    }
</style>
<h3>Facture N°: #{{ order.id }}</h3>
<h4>
    Date: <span>{{ order.createdAt|date('d-M-Y') }}</span>
</h4>
<table>
    <caption>Infos sur le client</caption>
    <tbody>
    <tr>
        <th>Nom</th>
        <td>{{ order.lastname }}</td>
    </tr>
    <tr>
        <th>Prénom</th>
        <td>{{ order.firstname }}</td>
    </tr>
    <tr>
        <th>Numéro de téléphone</th>
        <td>{{ order.phone }}</td>
    </tr>
    <tr>
        <th>Adresse</th>
        <td>{{ order.address }}</td>
    </tr>
    <tr>
        <th>Code postal</th>
        <td>{{ order.zipcode }}</td>
    </tr>
    <tr>
        <th>Ville</th>
        <td>{{ order.city.name }}</td>
    </tr>
    <tr>
        <th>Type de paiement</th>
        <td>
            {% if order.payondelivery %}
                <span>Payer à la livraison</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <th>Livraison</th>
        <td>{{ order.city.shippingcost|number_format(0, '', ' ') }} Ar</td>
    </tr>
    </tbody>
</table>

<table>
    <caption class="caption-top">Infos sur les produits</caption>
    <thead>
    <tr>
        <th>Titre</th>
        <th>Prix</th>
        <th>Quantité</th>
        <th>Total</th>
    </tr>
    </thead>
    {% set total = 0 %}
    <tbody>
    {% for item in order.orderproducts %}
        {% set product = item.product %}
        <tr>
            <td>{{ product.title }}</td>
            <td>{{ product.price|number_format(0, '',' ') }} Ar</td>
            <td>{{ item.quantity }}</td>
            <td>{{ (product.price * item.quantity)|number_format(0, '', ' ') }} Ar</td>
        </tr>
        {% set total = total + product.price * item.quantity %}
    {% endfor %}
    </tbody>
    <tfoot>
    <tr>
        <td colspan="3"><span></span></td>
        <td>{{ total|number_format(0, '', ' ') }} Ar</td>
    </tr>
    </tfoot>
</table>

<h2>Montant total: {{ order.totalprice|number_format(0, '', ' ') }} Ar</h2>
