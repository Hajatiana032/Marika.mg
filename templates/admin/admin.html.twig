{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - Admin({% block admin_title %}{% endblock %})
{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-2 bg-blue-600 position-fixed min-vh-100">
                {% include 'admin/partials/_sidebar.html.twig' %}
            </div>
            <div class="col-xl-10 ms-auto sticky-top">
                {% include 'admin/partials/_navbar.html.twig' %}
            </div>
            <div class="col-xl-10 ms-auto">
                <div class="container-fluid">
                    {% block main %}
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
