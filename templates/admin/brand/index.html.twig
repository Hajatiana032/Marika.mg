{% extends 'admin/admin.html.twig' %}

{% block admin_title %}Marques{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-xl-6">
            <h1>Liste des marques</h1>
        </div>
        <div class="col-xl-6 text-end">
            <a href="{{ path('app_admin_brand_new') }}" class="btn btn-emerald-500 ms-auto">
                <i class="fa fa-plus"></i>&nbsp;Nouvelle marque
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Slug</th>
                <th>Total de produits associés</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for brand in brands %}
                <tr>
                    <td>{{ brand.id }}</td>
                    <td>{{ brand.name }}</td>
                    <td>{{ brand.slug }}</td>
                    <td class="d-flex">
                        <div>
                            {{ brand.products|length }}
                        </div>
                        <div class="ms-auto">
                            <button class="btn btn-emerald-500" data-bs-target="#productList-{{ brand.id }}"
                                    data-bs-toggle="modal" {% if brand.products is empty %}disabled{% endif %}>Voir la
                                liste
                            </button>
                        </div>
                    </td>
                    <td>
                        <a href="{{ path('app_admin_brand_edit', {'id': brand.id}) }}" class="btn btn-warning">
                            <i class="far fa-edit"></i>&nbsp;Modifier
                        </a>
                        <a href="{{ path('app_admin_brand_delete', {'id': brand.id}) }}" class="btn btn-danger">
                            <i class="fa fa-trash"></i>&nbsp;Supprimer
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-danger">Aucun résultat</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% for brand in brands %}
        {% include 'admin/partials/_product_list_modal.html.twig' with {'title': 'Marque','item': brand} %}
    {% endfor %}
{% endblock %}
