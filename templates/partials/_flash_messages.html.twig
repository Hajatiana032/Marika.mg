{% for type, contents in app.flashes %}
    <div {% if type == 'success' or type == 'warning' %}data-controller="confetti"{% endif %}>
        {% for content in contents %}
            <div class="alert bg-{{ type }} text-{{ content.color }} text-center">
                <i class="far fa-check-circle">&nbsp;</i>
                {{ content.message|raw }}
            </div>
        {% endfor %}
    </div>
{% endfor %}
